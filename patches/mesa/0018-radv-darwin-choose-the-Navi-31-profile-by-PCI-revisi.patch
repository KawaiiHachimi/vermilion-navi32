From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vermilion contributors <vermilion@example.invalid>
Date: Mon, 23 Nov 2026 00:00:00 +0000
Subject: [PATCH 18/18] radv/darwin: choose the Navi 31 profile by PCI revision (RX
 7900 XTX = navi31)

The RX 7900 XTX (PCI revision 0xc8) ran the RX 7900 XT's canned profile
(84 CUs, 20 of 24 GL2 channels). acd_canned_device() now reads the
revision-id of the PCI device under NMXAccel (or PhxBringup) and takes
Mesa's own navi31 entry, which describes an XTX, for 0xc8; any other or
unknown revision keeps navi31_xt as before. RADV_DARWIN_CANNED still
overrides. The marketing name and the VCN shim match every navi31
profile instead of navi31_xt exactly.
---
 src/amd/common/darwin/ac_darwin_drm.c | 59 ++++++++++++++++++++++++++-
 1 file changed, 57 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 0577685..5c9e562 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -9,6 +9,7 @@
 #include "ac_darwin_budget.h"
 
 #include <errno.h>
+#include <IOKit/IOKitLib.h>
 #include <os/log.h>
 #include <pthread.h>
 #include <stdio.h>
@@ -103,11 +104,63 @@ find_canned(const char *name);
 
 /* Canned device selection: RADV_DARWIN_CANNED names an amdgpu_devices[] entry, default "phoenix"
  * (Radeon 780M / gfx1103 / GC 11.0.1). The values that used to be gfx1201 constants come from it. */
+/* Navi 31 boards by PCI revision (Linux amdgpu tells them apart the same way): 0xc8 = RX 7900 XTX, all 96 CUs and
+ * 24 GL2 channels, Mesa's own "navi31" entry; 0xcc = RX 7900 XT, 84 CUs and 20 channels, "navi31_xt" (0016). The
+ * revision is the "revision-id" of the PCI device under the accelerator (NMXAccel, which the sandboxed path opens
+ * too) or under the bring-up service; -1 when neither is a 1002:744c device. Read once per process. */
+static int
+acd_navi31_pci_revision(void)
+{
+   static int rev = -2;
+   if (rev != -2)
+      return rev;
+   int r = -1;
+   static const char *const classes[] = {"NMXAccel", ACD_SERVICE_PHOENIX};
+   for (unsigned i = 0; i < ARRAY_SIZE(classes) && r < 0; i++) {
+      io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(classes[i]));
+      io_registry_entry_t pci = 0;
+      if (!svc)
+         continue;
+      if (IORegistryEntryGetParentEntry(svc, kIOServicePlane, &pci) == KERN_SUCCESS) {
+         uint32_t v[3] = {0, 0, 0}; /* vendor-id, device-id, revision-id: 4-byte little-endian data */
+         static const char *const keys[] = {"vendor-id", "device-id", "revision-id"};
+         for (unsigned k = 0; k < 3; k++) {
+            CFStringRef key = CFStringCreateWithCString(kCFAllocatorDefault, keys[k], kCFStringEncodingASCII);
+            CFTypeRef d = key ? IORegistryEntryCreateCFProperty(pci, key, kCFAllocatorDefault, 0) : NULL;
+            if (d && CFGetTypeID(d) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)d) >= 4) {
+               const UInt8 *b = CFDataGetBytePtr((CFDataRef)d);
+               v[k] = b[0] | b[1] << 8 | b[2] << 16 | (uint32_t)b[3] << 24;
+            }
+            if (d)
+               CFRelease(d);
+            if (key)
+               CFRelease(key);
+         }
+         if ((v[0] & 0xffff) == 0x1002 && (v[1] & 0xffff) == 0x744c)
+            r = v[2] & 0xff;
+         IOObjectRelease(pci);
+      }
+      IOObjectRelease(svc);
+   }
+   rev = r;
+   return rev;
+}
+
 const struct amdgpu_device *
 acd_canned_device(void)
 {
    const char *name = getenv("RADV_DARWIN_CANNED");
-   return find_canned(name && *name ? name : "navi31_xt");   /* navi31 fork: RX 7900 XT */
+   if (name && *name)
+      return find_canned(name);
+   /* navi31 fork: the card's own profile; an unknown revision keeps the RX 7900 XT's, as before */
+   return find_canned(acd_navi31_pci_revision() == 0xc8 ? "navi31" : "navi31_xt");
+}
+
+/* the Navi 31 profiles (navi31 = XTX, navi31_xt = XT, and any later navi31_* entry) */
+static bool
+acd_canned_is_navi31(const struct amdgpu_device *d)
+{
+   return d && !strncmp(d->name, "navi31", 6);
 }
 
 uint32_t
@@ -380,6 +433,8 @@ acd_get_marketing_name(acd_device_handle dev)
       return "AMD Radeon 780M Graphics";
    if (!strcmp(dev->canned->name, "navi31_xt"))
       return "AMD Radeon RX 7900 XT";
+   if (!strcmp(dev->canned->name, "navi31"))
+      return "AMD Radeon RX 7900 XTX";
    return ACD_MARKETING_NAME;
 }
 
@@ -491,7 +546,7 @@ acd_info_memory(struct acd_device *dev, const struct drm_amdgpu_info *info, void
 static bool
 acd_vcn(const struct acd_device *dev)
 {
-   if (!dev->core->kext || strcmp(dev->canned->name, "navi31_xt"))
+   if (!dev->core->kext || !acd_canned_is_navi31(dev->canned))
       return false;
    if (env_is_1("RADV_DARWIN_VCN"))
       return true;
-- 
