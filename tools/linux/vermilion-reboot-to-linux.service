# SPDX-License-Identifier: MIT
# A Linux reboot starts Linux again (BootNext = Limine); a power-off is untouched, so power-on starts OpenCore.
# Install: reboot_to_linux.sh -> /usr/local/sbin/vermilion-reboot-to-linux, this file -> /etc/systemd/system/,
# then `systemctl enable vermilion-reboot-to-linux.service`. See tools/linux/reboot_to_linux.sh.
[Unit]
Description=Vermilion: a Linux reboot starts Linux again, never macOS on a warm GPU
DefaultDependencies=no
Before=umount.target final.target systemd-reboot.service reboot.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vermilion-reboot-to-linux Limine

[Install]
WantedBy=reboot.target
